    {
      "name": "04 Ingreso de dinero y actividad (sprint 3)",
      "description": "Carga de saldo desde tarjeta, actividad, filtros y detalle.",
      "item": [
        {
          "name": "Ingresar dinero desde la tarjeta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/accounts/{{accountId}}/transferences",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardId\": {{cardId}},\n  \"amount\": 5000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "pm.test('Es un ingreso', () => pm.expect(pm.response.json().type).to.equal('DEPOSIT'));",
                  "pm.collectionVariables.set('depositId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Ingresar un monto inválido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/accounts/{{accountId}}/transferences",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardId\": {{cardId}},\n  \"amount\": -10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver el saldo después del ingreso",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/accounts/{{accountId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Saldo 5000', () => pm.expect(pm.response.json().balance).to.equal(5000));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver toda la actividad",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/accounts/{{accountId}}/activity"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('El ingreso es el primer movimiento', () => pm.expect(pm.response.json()[0].id).to.equal(Number(pm.collectionVariables.get('depositId'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filtrar la actividad (ingresos de más de $1.000)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/accounts/{{accountId}}/activity?direction=INCOME&minAmount=1000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Un movimiento', () => pm.expect(pm.response.json()).to.have.lengthOf(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Detalle de la actividad",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/accounts/{{accountId}}/activity/{{depositId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Monto 5000', () => pm.expect(pm.response.json().amount).to.equal(5000));"
                ]
              }
            }
          ]
        },
        {
          "name": "Detalle de una actividad inexistente",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/accounts/{{accountId}}/activity/999999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 Transferencias (sprint 4)",
      "description": "Transferencias, fondos insuficientes, idempotencia, destinatarios y comprobante.",
      "item": [
        {
          "name": "Registrar un destinatario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Ana\",\n  \"lastName\": \"Gómez\",\n  \"dni\": \"{{recipientDni}}\",\n  \"email\": \"{{recipientEmail}}\",\n  \"phone\": \"+5491122334455\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('recipientEmail', 'qa.destino.' + Date.now() + '@mail.com');",
                  "pm.collectionVariables.set('recipientDni', String((Date.now() + 7) % 100000000).padStart(8, '0'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('recipientAlias', pm.response.json().alias);",
                  "pm.collectionVariables.set('recipientCvu', pm.response.json().cvu);"
                ]
              }
            }
          ]
        },
        {
          "name": "Transferir por alias",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/accounts/{{accountId}}/transferences",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destination\": \"{{recipientAlias}}\",\n  \"amount\": 1000,\n  \"description\": \"Alquiler\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Es un egreso hacia el destinatario', () => {",
                  "    pm.expect(body.type).to.equal('TRANSFER_OUT');",
                  "    pm.expect(body.counterpart.alias).to.equal(pm.collectionVariables.get('recipientAlias'));",
                  "});",
                  "pm.collectionVariables.set('transferId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Transferir por CVU",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/accounts/{{accountId}}/transferences",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destination\": \"{{recipientCvu}}\",\n  \"amount\": 500\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Transferir sin fondos suficientes",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/accounts/{{accountId}}/transferences",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destination\": \"{{recipientAlias}}\",\n  \"amount\": 999999\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 410', () => pm.response.to.have.status(410));"
                ]
              }
            }
          ]
        },
        {
          "name": "Transferir a una cuenta inexistente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/accounts/{{accountId}}/transferences",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destination\": \"no.existe.nadie\",\n  \"amount\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Transferir con clave de idempotencia",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": "{{baseUrl}}/accounts/{{accountId}}/transferences",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destination\": \"{{recipientAlias}}\",\n  \"amount\": 100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('idempotencyKey', 'postman-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('No es una repetición', () => pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.equal('false'));",
                  "pm.collectionVariables.set('idempotentTransferId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Reenviar la misma transferencia (misma clave)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": "{{baseUrl}}/accounts/{{accountId}}/transferences",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destination\": \"{{recipientAlias}}\",\n  \"amount\": 100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve la transferencia original sin repetirla', () => {",
                  "    pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.equal('true');",
                  "    pm.expect(pm.response.json().id).to.equal(Number(pm.collectionVariables.get('idempotentTransferId')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Últimos destinatarios",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/accounts/{{accountId}}/transferences"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('El destinatario aparece una sola vez', () => {",
                  "    const list = pm.response.json();",
                  "    pm.expect(list).to.have.lengthOf(1);",
                  "    pm.expect(list[0].alias).to.equal(pm.collectionVariables.get('recipientAlias'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Descargar el comprobante en PDF",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/accounts/{{accountId}}/activity/{{transferId}}/receipt"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Es un PDF', () => pm.expect(pm.response.headers.get('Content-Type')).to.equal('application/pdf'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver el saldo final",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/accounts/{{accountId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('5000 - 1000 - 500 - 100 = 3400', () => pm.expect(pm.response.json().balance).to.equal(3400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "06 Cierre de sesión (sprint 1)",
      "description": "Logout e invalidación del token.",
      "item": [
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/user/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Usar el token después del logout",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/accounts/{{accountId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}