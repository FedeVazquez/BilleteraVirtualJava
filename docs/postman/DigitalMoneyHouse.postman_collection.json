      "key": "baseUrl",
      "value": "http://localhost:8090"
    },
    {
      "key": "mailhogUrl",
      "value": "http://localhost:8025"
    },
    {
      "key": "password",
      "value": "Clave1234"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "dni",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "accountId",
      "value": ""
    },
    {
      "key": "cvu",
      "value": ""
    },
    {
      "key": "alias",
      "value": ""
    },
    {
