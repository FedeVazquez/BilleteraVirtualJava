              "mode": "raw",
              "raw": "{\n  \"number\": \"{{cardNumber}}\",\n  \"holderName\": \"Juan Perez\",\n  \"expiration\": \"10/38\",\n  \"cvv\": \"456\",\n  \"type\": \"CREDIT\"\n}",
              "options": {
