            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function luhnCard() {\n    const base = '4' + String(Date.now()).padStart(14, '0').slice(-14);\n    let sum = 0;\n    for (let i = 0; i < base.length; i++) {\n        let digit = Number(base[base.length - 1 - i]);\n        if (i % 2 === 0) { digit *= 2; if (digit > 9) digit -= 9; }\n        sum += digit;\n    }\n    return base + ((10 - sum % 10) % 10);\n}",
