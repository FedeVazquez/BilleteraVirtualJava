  "item": [
    {
      "name": "01 Registro y acceso (sprint 1)",
      "description": "Registro, verificación del email con el código del mail, login.",
      "item": [
        {
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Juan\",\n  \"lastName\": \"Pérez\",\n  \"dni\": \"{{dni}}\",\n  \"email\": \"{{email}}\",\n  \"phone\": \"+5491122334455\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('email', 'qa.' + Date.now() + '@mail.com');",
                  "pm.collectionVariables.set('dni', String(Date.now() % 100000000).padStart(8, '0'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve CVU de 22 dígitos y alias de 3 palabras', () => {",
                  "    pm.expect(body.cvu).to.match(/^\\d{22}$/);",
                  "    pm.expect(body.alias).to.match(/^[a-z]+\\.[a-z]+\\.[a-z]+$/);",
                  "});",
                  "pm.test('No devuelve la contraseña', () => pm.expect(body.password).to.equal(undefined));",
                  "pm.collectionVariables.set('userId', body.id);",
                  "pm.collectionVariables.set('accountId', body.accountId);",
                  "pm.collectionVariables.set('cvu', body.cvu);",
                  "pm.collectionVariables.set('alias', body.alias);"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar con email repetido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Juan\",\n  \"lastName\": \"Pérez\",\n  \"dni\": \"12345678\",\n  \"email\": \"{{email}}\",\n  \"phone\": \"+5491122334455\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login sin verificar el email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Leer el código de verificación (MailHog)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{mailhogUrl}}/api/v2/search?kind=to&query={{email}}",
            "description": "Lee el mail que recibió el usuario en MailHog y guarda el código de 6 dígitos."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const items = pm.response.json().items;",
                  "pm.test('Llegó el mail de verificación', () => pm.expect(items.length).to.be.above(0));",
                  "const text = items[0].Content.Body.replace(/=\\r?\\n/g, '');",
                  "const code = text.match(/\\b(\\d{6})\\b/)[1];",
                  "pm.collectionVariables.set('verificationCode', code);"
                ]
              }
            }
          ]
        },
        {
          "name": "Verificar el email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/verify-email",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"{{verificationCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve un token Bearer', () => pm.expect(body.tokenType).to.equal('Bearer'));",
                  "pm.collectionVariables.set('token', body.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con contraseña incorrecta",
