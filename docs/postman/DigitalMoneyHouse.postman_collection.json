    {
      "name": "03 Tarjetas (sprint 2)",
      "description": "Alta, listado, detalle y baja de tarjetas.",
      "item": [
        {
          "name": "Asociar una tarjeta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/accounts/{{accountId}}/cards",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"number\": \"{{cardNumber}}\",\n  \"holderName\": \"Juan Perez\",\n  \"expiration\": \"12/39\",\n  \"cvv\": \"123\",\n  \"type\": \"DEBIT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function luhnCard() {\n    const base = '4' + String(Date.now()).padStart(14, '0').slice(-14);\n    let sum = 0;\n    for (let i = 0; i < base.length; i++) {\n        let digit = Number(base[base.length - 1 - i]);\n        if (i % 2 === 0) { digit *= 2; if (digit > 9) digit -= 9; }\n        sum += digit;\n    }\n    return base + ((10 - sum % 10) % 10);\n}",
                  "pm.collectionVariables.set('cardNumber', luhnCard());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "const card = pm.response.json();",
                  "pm.test('Solo expone los últimos 4 dígitos', () => {",
                  "    pm.expect(card.lastFour).to.equal(pm.collectionVariables.get('cardNumber').slice(-4));",
                  "    pm.expect(pm.response.text()).to.not.include(pm.collectionVariables.get('cardNumber'));",
                  "});",
                  "pm.collectionVariables.set('cardId', card.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Asociar la misma tarjeta otra vez",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/accounts/{{accountId}}/cards",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"number\": \"{{cardNumber}}\",\n  \"holderName\": \"Juan Perez\",\n  \"expiration\": \"12/39\",\n  \"cvv\": \"123\",\n  \"type\": \"DEBIT\"\n}",
