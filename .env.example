# Copiar a ".env" (que NO se sube a Git) y cambiar los valores.
# docker compose lee este archivo automaticamente.

# Secreto con el que se firman los JWT (minimo 32 caracteres). Lo comparten todos los servicios.
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio-de-32+
# Clave que identifica las llamadas internas entre microservicios (/internal/**).
INTERNAL_API_KEY=cambiar-por-otra-clave-aleatoria
# Clave para la huella de los numeros de tarjeta. No cambiarla una vez que hay tarjetas cargadas.
CARD_FINGERPRINT_KEY=cambiar-por-una-tercera-clave-aleatoria

MYSQL_ROOT_PASSWORD=cambiar-root
DB_PASSWORD=cambiar-dmh

# --- Solo para docker-compose.aws.yml (despliegue en AWS) ---
# URL publica de la API (la del balanceador o dominio). Se usa en el link de recupero de contraseña.
PUBLIC_URL=https://api.tu-dominio.com
# Origenes del frontend que pueden llamar a la API (CORS).
CORS_ALLOWED_ORIGINS=https://tu-dominio.com
# Servidor SMTP real (por ejemplo Amazon SES: email-smtp.us-east-1.amazonaws.com, puerto 587).
MAIL_HOST=email-smtp.us-east-1.amazonaws.com
MAIL_USERNAME=usuario-smtp
MAIL_PASSWORD=clave-smtp
MAIL_FROM=no-reply@tu-dominio.com
# Imagenes publicadas por el workflow "Publicar imagenes" (o el registro de Amazon ECR).
IMAGE_REGISTRY=ghcr.io/fedevazquez
IMAGE_TAG=latest
# Para usar Amazon RDS en lugar del contenedor MySQL: endpoint de RDS.
# DB_HOST=dmh.xxxxxxxx.us-east-1.rds.amazonaws.com

# Puertos publicados en la maquina (cambiar si estan ocupados).
GATEWAY_PORT=8090
MYSQL_PORT=3307
