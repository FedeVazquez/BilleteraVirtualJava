# Copiar a ".env" (que NO se sube a Git) y cambiar los valores.
# docker compose lee este archivo automaticamente.

# Secreto con el que se firman los JWT (minimo 32 caracteres). Lo comparten todos los servicios.
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio-de-32+
# Clave que identifica las llamadas internas entre microservicios (/internal/**).
INTERNAL_API_KEY=cambiar-por-otra-clave-aleatoria
# Clave para la huella de los numeros de tarjeta. No cambiarla una vez que hay tarjetas cargadas.
CARD_FINGERPRINT_KEY=cambiar-por-una-tercera-clave-aleatoria

MYSQL_ROOT_PASSWORD=cambiar-root
DB_PASSWORD=cambiar-dmh

# Puertos publicados en la maquina (cambiar si estan ocupados).
GATEWAY_PORT=8090
MYSQL_PORT=3307
